{
  "name": "next-persian-fonts-site",
  "version": "1.1.0",
  "private": true,
  "description": "Demo/docs site and tooling for the next-persian-fonts package (published from src/next-persian-fonts).",
  "workspaces": [
    "src/next-persian-fonts"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/preview.mjs",
    "lint": "eslint .",
    "fonts:generate": "node scripts/generate-fonts.mjs",
    "fonts:update": "node scripts/update-fonts.mjs",
    "fonts:check-upstream": "node scripts/update-fonts.mjs --check",
    "verify": "node scripts/verify-package.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "pack:dry": "npm pack --dry-run -w next-persian-fonts"
  },
  "dependencies": {
    "next": "^16.3.8",
    "next-persian-fonts": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
